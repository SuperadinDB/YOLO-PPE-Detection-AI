# ==========================================
# EPP Detector - .gitignore
# ==========================================


# ------------------------------------------
# Python
# ------------------------------------------

__pycache__/
*.py[cod]
*$py.class
*.so

.Python
*.egg
*.egg-info/
.eggs/
.installed.cfg
MANIFEST

pip-log.txt
pip-delete-this-directory.txt


# ------------------------------------------
# Virtual environments
# ------------------------------------------

.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

.env
.envrc


# ------------------------------------------
# PyInstaller
# ------------------------------------------

build/
dist/

# IMPORTANT:
# epp_detector.spec is intentionally NOT ignored.
# It is part of the reproducible build configuration.

*.manifest


# ------------------------------------------
# AppImage
# ------------------------------------------

AppDir/

# Compiled AppImages are distributed through
# GitHub Releases instead of Git.
*.AppImage

# Local AppImage build tool
appimagetool-*.AppImage


# ------------------------------------------
# YOLO datasets / training
# ------------------------------------------

data/
runs/

# Ultralytics cache
*.cache


# ------------------------------------------
# Training / experimentation
# ------------------------------------------

notebooks/
weights/

.ipynb_checkpoints/


# ------------------------------------------
# Temporary video files
# ------------------------------------------

background_*.mp4
temp_*.mp4
tmp_*.mp4

*.tmp


# ------------------------------------------
# Streamlit
# ------------------------------------------

.streamlit/secrets.toml


# ------------------------------------------
# Tests / coverage
# ------------------------------------------

htmlcov/
.tox/
.nox/

.coverage
.coverage.*

.pytest_cache/
.hypothesis/

nosetests.xml
coverage.xml

*.cover
*.py.cover


# ------------------------------------------
# Type checking / linters
# ------------------------------------------

.mypy_cache/
.dmypy.json
dmypy.json

.pyre/
.pytype/
.ruff_cache/


# ------------------------------------------
# Jupyter / IPython
# ------------------------------------------

profile_default/
ipython_config.py


# ------------------------------------------
# IDEs / editors
# ------------------------------------------

# VS Code local configuration
.vscode/

# PyCharm
.idea/

# Spyder
.spyderproject
.spyproject

# Rope
.ropeproject

# Temporary editor files
*.swp
*.swo
*~
tempCodeRunnerFile.py


# ------------------------------------------
# Operating system
# ------------------------------------------

.DS_Store
Thumbs.db
desktop.ini


# ------------------------------------------
# Logs
# ------------------------------------------

*.log


# ------------------------------------------
# Build / packaging leftovers
# ------------------------------------------

develop-eggs/
downloads/
eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/

target/


# ------------------------------------------
# Project-specific files that ARE kept
# ------------------------------------------

# These are intentionally versioned:
#
# app.py
# launcher.py
# epp_detector.spec
# requirements.txt
# README.md
# src/
# ui/
# models/sh17_model.pt
# samples/ppe_sample.mp4